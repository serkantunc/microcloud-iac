#cloud-config
hostname: ${hostname}
fqdn: ${hostname}.${domain}
manage_etc_hosts: true
timezone: ${timezone}

users:
  - name: ${user}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: ${console_password == "" ? "true" : "false"}
    ssh_authorized_keys:
      - ${jsonencode(ssh_public_key)}
%{ if console_password != "" ~}

chpasswd:
  expire: false
  users:
    - name: ${user}
      password: ${jsonencode(console_password)}
      type: text
%{ endif ~}

ssh_pwauth: false
